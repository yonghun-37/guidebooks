# 선택 live 초안 저장에만 읽습니다. 값을 넣은 .env·auth/는 공개하지 마세요.
# Blogger: OAuth 사용자 동의로 발급한 blogger scope 액세스 토큰 (API key 아님)
BLOGGER_BLOG_ID=
BLOGGER_ACCESS_TOKEN=
# 대안: 키트 기준 상대 경로 또는 절대 경로의 인증 JSON(access_token 또는 token)
BLOGGER_TOKEN_FILE=
# 설치형 WordPress만 지원. 주 로그인 비밀번호가 아닌 애플리케이션 비밀번호
WP_URL=
WP_USER=
WP_APP_PASSWORD=
